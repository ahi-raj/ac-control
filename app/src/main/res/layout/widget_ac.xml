<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_mochi"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Mochi"
            android:src="@drawable/mochi_happy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textColor="#3D3229"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cool"
                android:textColor="#7A6B5C"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/w_power"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/w_btn_on"
            android:contentDescription="Power"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_power" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/w_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/w_btn"
            android:contentDescription="Colder"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_minus" />

        <ImageButton
            android:id="@+id/w_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/w_btn"
            android:contentDescription="Warmer"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_plus" />
    </LinearLayout>
</LinearLayout>
